# Supabase project connection
SUPABASE_URL=https://your-project-ref.supabase.co
# Use a server-side secret/service_role key only. Never expose it in a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Must match the Edge Function secret configured with `supabase secrets set`.
EDGE_FUNCTION_SECRET=replace-with-a-long-random-string

# Optional application settings
SUPABASE_BUCKET=documents
EDGE_FUNCTION_NAME=validate-upload
APP_USER=terminal-user
MAX_FILE_SIZE_BYTES=10485760

